# ───────────────────────────────────────────────────────────────
# ATELIER — variables de entorno
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env`.
# Las variables sin prefijo NEXT_PUBLIC_ son SECRETAS y solo se leen en el servidor.
# ───────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────
# URL pública de la app (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# ── Base de datos (Supabase · PostgreSQL) ──────────────────────
# Pooler (Transaction mode, puerto 6543). Lo usa la app en runtime (Vercel es serverless).
DATABASE_URL=
# Conexión para migraciones (puerto 5432). La usa la CLI de Prisma.
# La "Direct connection" de Supabase es solo IPv6; si tu red no tiene IPv6,
# usa la URL del "Session pooler" (también puerto 5432, compatible con IPv4).
DIRECT_URL=

# ── Better Auth ────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL base de la app (local: http://localhost:3000)
BETTER_AUTH_URL=

# Google OAuth (Google Cloud Console → Credenciales)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe (SOLO modo test: sk_test_…) ─────────────────────────
STRIPE_SECRET_KEY=
# Local: lo imprime `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# ── Vercel Cron ────────────────────────────────────────────────
# Protege /api/cron/expire-orders. Mínimo 16 caracteres (openssl rand -hex 32)
CRON_SECRET=

# ── Seed (solo para `pnpm db:seed`) ────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Tests de integración (pnpm db:test:up && pnpm test:integration) ──
# Opcional: por defecto usa el Postgres de docker-compose.yml.
# DEBE ser una BD local: los tests vacían las tablas.
# TEST_DATABASE_URL=postgresql://atelier:atelier@localhost:54329/atelier_test
